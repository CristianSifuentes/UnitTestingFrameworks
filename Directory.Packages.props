<Project>
  <!-- Versiones verificadas en NuGet el 8 de noviembre de 2026 -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="MSTest" Version="4.5.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <!-- MSTest.Sdk ya declara su propia versión de la extensión TRX -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" Condition="'$(UsingMSTestSdk)' != 'true'" />
  </ItemGroup>
</Project>
